# Beacon — environment variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Backend API base URL (include /api/v1 suffix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# MapLibre basemap style from OpenFreeMap (no API key needed)
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# PMTiles source for offline Kenya basemap
NEXT_PUBLIC_PMTILES_URL=https://data.source.coop/protomaps/openstreetmap/tiles/v3.pmtiles

# Sentry DSN — fill in after creating a Sentry project
NEXT_PUBLIC_SENTRY_DSN=

# Application environment
NEXT_PUBLIC_APP_ENV=development

# Sentry auth token — server-side only, used during build for source maps
SENTRY_AUTH_TOKEN=
